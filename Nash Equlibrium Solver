def dominance_elimination(A, B, max_rounds=20):
    """
    Iterated elimination of strictly dominated strategies.
    A = row player payoff matrix
    B = col player payoff matrix
    Returns reduced matrices and which strategies survived.
    """
    rows = list(range(A.shape[0]))
    cols = list(range(A.shape[1]))

    changed = True
    rounds  = 0
    log     = []

    while changed and rounds < max_rounds:
        changed = False
        rounds += 1

        # Check row player dominated strategies
        to_remove = []
        for r in rows:
            for r2 in rows:
                if r == r2: continue
                # r is dominated by r2 if r2 always better
                if all(A[r2, c] > A[r, c] for c in cols):
                    to_remove.append(r)
                    log.append(f"Row {r} dominated by Row {r2}")
                    break
        for r in to_remove:
            if r in rows:
                rows.remove(r)
                changed = True

        # Check col player dominated strategies
        to_remove = []
        for c in cols:
            for c2 in cols:
                if c == c2: continue
                if all(B[r, c2] > B[r, c] for r in rows):
                    to_remove.append(c)
                    log.append(f"Col {c} dominated by Col {c2}")
                    break
        for c in to_remove:
            if c in cols:
                cols.remove(c)
                changed = True

    return rows, cols, log


def find_pure_nash(A, B):
    """Find all pure strategy Nash equilibria."""
    n_rows, n_cols = A.shape
    equilibria = []

    for r in range(n_rows):
        for c in range(n_cols):
            # Check: is row r best response to col c?
            row_br = A[r, c] == np.max(A[:, c])
            # Check: is col c best response to row r?
            col_br = B[r, c] == np.max(B[r, :])
            if row_br and col_br:
                equilibria.append((r, c, A[r,c], B[r,c]))

    return equilibria


def find_mixed_nash_2x2(A, B):
    """
    Find mixed strategy Nash equilibrium for 2x2 games.
    Uses the indifference condition: each player mixes so the
    opponent is indifferent between their pure strategies.
    """
    # Row player mixes p on row 0, (1-p) on row 1
    # Col player indifferent: p*B[0,0] + (1-p)*B[1,0] = p*B[0,1] + (1-p)*B[1,1]
    # p*(B[0,0]-B[1,0]-B[0,1]+B[1,1]) = B[1,1]-B[1,0]

    denom_p = (B[0,0] - B[1,0] - B[0,1] + B[1,1])
    denom_q = (A[0,0] - A[0,1] - A[1,0] + A[1,1])

    results = {}

    if abs(denom_p) > 1e-10:
        p = (B[1,1] - B[1,0]) / denom_p
        if 0 <= p <= 1:
            results['row_mix'] = (round(p,4), round(1-p,4))
            results['row_payoff'] = round(p*A[0,0] + (1-p)*A[1,0], 4)
    if abs(denom_q) > 1e-10:
        q = (A[1,1] - A[0,1]) / denom_q
        if 0 <= q <= 1:
            results['col_mix'] = (round(q,4), round(1-q,4))
            results['col_payoff'] = round(q*B[0,0] + (1-q)*B[0,1], 4)

    return results


